WINDY_API_KEY=replace-with-your-windy-map-api-key
WINDY_AUTH_HOSTNAME=weather-proxy.theonly.vip
WINDY_ALLOWED_APP_HOSTS=localhost,127.0.0.1,weather.sh-newenergy.com
