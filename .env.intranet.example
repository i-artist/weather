WEATHER_IMAGE=weather-pro:latest
HTTP_PORT=80
HTTPS_PORT=443
TEST_PORT=8890
WINDY_PROXY_UPSTREAM=https://weather-proxy.theonly.vip:16666
WINDY_BOOT_URL=https://weather-proxy.theonly.vip:16666/windy/libBoot.js?proxy=2

# 申能单点登录（SSO）配置（与 device 项目保持一致）
# 是否启用单点登录：yes 启用 / no 关闭
SSO_ENABLED=yes
SHENNER_BASE_URL=https://fgcapi.shenergy.net.cn
SHENNER_FGCAPI_HOST=https://fgcapi.shenergy.net.cn
SHENNER_FGCAM_HOST=https://fgcam.shenergy.net.cn
SHENNER_USERNAME=
SHENNER_IOA_SECRET=
SHENNER_JWT_SECRET=
SSO_TIMEOUT_SECONDS=10
AUTH_SESSION_HOURS=8
